# ============================================================
# Iberian_Shakti
# Local environment configuration template
# ============================================================

APP_ENV=development
LOG_LEVEL=INFO

# Local ingestion (export explicitly; no automatic .env loading)
RAW_ARCHIVE_ROOT=data/raw
INGESTION_TIMEOUT_SECONDS=10
# Total attempts, including the initial attempt
INGESTION_MAX_ATTEMPTS=3
INGESTION_BACKOFF_SECONDS=1

# ESIOS / Red Eléctrica de España
ESIOS_API_TOKEN=

# ENTSO-E Transparency Platform
ENTSOE_API_TOKEN=

# Snowflake
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
